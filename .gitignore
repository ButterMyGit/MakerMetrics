# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local runtime dirs, secrets, and settings
/data/
/secrets/
/settings/
/scripts/
/web/
__pycache__/

# local agent instructions and workspace metadata
/AGENTS.md
/CLAUDE.md
/.agents/
/.codex/

# private database migration history
/supabase/migrations/

# retired local prototype
/legacy/
